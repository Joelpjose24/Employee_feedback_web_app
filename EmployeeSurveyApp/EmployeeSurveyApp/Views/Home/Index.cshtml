@{
    ViewData["Title"] = "Home Portal";
}

<div class="py-4">
    <!-- Hero Header -->
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold mb-3">
            Company Workplace Portal
        </span>
        <h1 class="display-5 fw-bold text-dark mb-3">Welcome to Employee Portal</h1>
        <p class="lead text-muted mx-auto" style="max-width: 650px;">
            Please select your portal below to sign in and proceed.
        </p>
    </div>

    <!-- Portal Selection Cards -->
    <div class="row g-4 justify-content-center mb-5">
        <!-- Employee Portal Card -->
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 border-0 shadow-sm hover-shadow rounded-4 transition-all">
                <div class="card-body p-4 p-lg-5 d-flex flex-column text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                            </svg>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark">Employee Portal</h3>
                    <p class="text-muted flex-grow-1">
                        Sign in with your employee code and work email to access your employee account and portal.
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Home" asp-action="EmployeeLogin" class="btn btn-primary btn-lg w-100 fw-semibold rounded-pill py-2 shadow-sm">
                            Employee Login &rarr;
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center rounded-bottom-4">
                    <span class="small text-muted">
                        Secure Employee Access
                    </span>
                </div>
            </div>
        </div>

        <!-- Admin Portal Card -->
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 border-0 shadow-sm hover-shadow rounded-4 transition-all">
                <div class="card-body p-4 p-lg-5 d-flex flex-column text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex p-3 rounded-circle bg-dark bg-opacity-10 text-dark">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                                <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                            </svg>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark">Admin Portal</h3>
                    <p class="text-muted flex-grow-1">
                        Administrative access to manage organizational settings, accounts, and reports.
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Home" asp-action="AdminLogin" class="btn btn-dark btn-lg w-100 fw-semibold rounded-pill py-2 shadow-sm">
                            Admin Login &rarr;
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center rounded-bottom-4">
                    <span class="small text-muted">
                        Authorized Management Only
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Features Section -->
    <div class="row g-4 text-center mt-2">
        <div class="col-md-4">
            <div class="p-3">
                <div class="fw-bold text-dark mb-1">🔒 Confidential & Secure</div>
                <p class="small text-muted mb-0">Encrypted authentication and protected employee data.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <div class="fw-bold text-dark mb-1">🏢 Centralized Directory</div>
                <p class="small text-muted mb-0">Seamless connectivity across all departments and roles.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <div class="fw-bold text-dark mb-1">⚡ Fast & Responsive</div>
                <p class="small text-muted mb-0">Optimized for desktop and mobile access anytime, anywhere.</p>
            </div>
        </div>
    </div>
</div>
