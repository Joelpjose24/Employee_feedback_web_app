@model EmployeeSurveyApp.Models.SurveyForm
@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
            <div class="card-header bg-danger bg-gradient text-white py-4">
                <div class="mb-2">
                    <span class="badge bg-white text-danger rounded-pill px-3 py-1 fw-bold text-uppercase fs-7">
                        🔒 Restricted Survey Access
                    </span>
                </div>
                <h3 class="fw-bold mb-0">Unauthorized PERNR</h3>
            </div>
            <div class="card-body p-4 p-md-5 bg-white">
                <div class="mb-4">
                    <span class="badge bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-shield-x" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                            <path d="M6.146 5.146a.5.5 0 0 1 .708 0L8 6.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 7l1.147 1.146a.5.5 0 0 1-.708.708L8 7.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 7 6.146 5.854a.5.5 0 0 1 0-.708"/>
                        </svg>
                    </span>
                </div>

                <h4 class="fw-bold text-dark mb-2">@Model.Title</h4>
                <div class="alert alert-danger py-2 small mb-4">
                    @(ViewBag.Message ?? "You are not authorized to attend this survey.")
                </div>

                <p class="text-muted small">
                    This survey is private and restricted by the administrator. Only designated personnel with permitted PERNR numbers have access rights.
                </p>

                <div class="mt-4 d-grid gap-2">
                    <a asp-action="EmployeeLogin" class="btn btn-outline-secondary rounded-pill py-2">
                        &larr; Return to Employee Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
