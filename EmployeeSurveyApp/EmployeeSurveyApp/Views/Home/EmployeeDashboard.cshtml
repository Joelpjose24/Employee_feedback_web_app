@model List<EmployeeSurveyApp.Models.SurveyForm>
@{
    ViewData["Title"] = "Employee Dashboard";
    var pernr = ViewBag.Pernr as string ?? "";
    var employeeName = ViewBag.EmployeeName as string ?? "Employee";
    var department = ViewBag.Department as string ?? "";
    var designation = ViewBag.Designation as string ?? "";
    var submittedSurveyIds = ViewBag.SubmittedSurveyIds as List<int> ?? new();
    int pendingCount = Model.Count(s => !submittedSurveyIds.Contains(s.Id));
    int completedCount = Model.Count(s => !submittedSurveyIds.Contains(s.Id) == false);
}

<div class="py-4">
    <!-- Top Welcome & Profile Header -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
        <div class="card-body p-4 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <h2 class="h3 fw-bold mb-0 text-dark">Welcome, @employeeName!</h2>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                PERNR: @pernr
                            </span>
                        </div>
                        <p class="text-muted small mb-0">
                            @if (!string.IsNullOrWhiteSpace(designation))
                            {
                                <span>@designation</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(department))
                            {
                                <span> &bull; @department</span>
                            }
                            &bull; Employee Survey Portal
                        </p>
                    </div>
                </div>

                <!-- Sign Out Button -->
                <div>
                    <a asp-action="EmployeeLogin" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                            <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                        </svg>
                        <span>Sign Out</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Assigned Surveys</span>
                        <h2 class="fw-bold mb-0 text-dark mt-1">@Model.Count</h2>
                    </div>
                    <div class="p-3 bg-secondary bg-opacity-10 rounded-circle text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-clipboard2-check" viewBox="0 0 16 16">
                            <path d="M9.5 0a.5.5 0 0 1 .5.5.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V2a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 5 2v-.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5.5.5 0 0 1 .5-.5z"/>
                            <path d="M3 2.5a.5.5 0 0 1 .5-.5H4a.5.5 0 0 0 0-1h-.5A1.5 1.5 0 0 0 2 2.5v12A1.5 1.5 0 0 0 3.5 16h9a1.5 1.5 0 0 0 1.5-1.5v-12A1.5 1.5 0 0 0 12.5 1H12a.5.5 0 0 0 0 1h.5a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5z"/>
                            <path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Pending Surveys</span>
                        <h2 class="fw-bold mb-0 text-warning mt-1">@pendingCount</h2>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 rounded-circle text-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-hourglass-split" viewBox="0 0 16 16">
                            <path d="M2.5 15a.5.5 0 1 1 0-1h1v-1a4.5 4.5 0 0 1 2.557-4.06c.29-.139.443-.377.443-.59v-.7c0-.213-.154-.451-.443-.59A4.5 4.5 0 0 1 3.5 4V3h-1a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1h-1v1a4.5 4.5 0 0 1-2.557 4.06c-.29.139-.443.377-.443.59v.7c0 .213.154.451.443.59A4.5 4.5 0 0 1 12.5 12v1h1a.5.5 0 0 1 0 1zm2-13v1c0 .537.12 1.045.337 1.5h6.326c.216-.455.337-.963.337-1.5V2zm3 6.35c.249.074.496.188.707.34a3.5 3.5 0 0 1 1.793 3.01v1.3h-7v-1.3a3.5 3.5 0 0 1 1.793-3.01c.211-.152.458-.266.707-.34z"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Completed Surveys</span>
                        <h2 class="fw-bold mb-0 text-success mt-1">@completedCount</h2>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 rounded-circle text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                            <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Surveys Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
        <div class="card-header bg-white border-bottom p-4">
            <h4 class="fw-bold mb-0 text-dark">Your Assigned Surveys</h4>
            <p class="text-muted small mb-0">Surveys authorized for your Personnel Number (PERNR: <code>@pernr</code>)</p>
        </div>

        <div class="card-body p-4">
            @if (!Model.Any() || pendingCount == 0 && !Model.Any())
            {
                <!-- EXACT REQUIREMENT: IF NO SURVEY IS AVAILABLE SHOW NO PENDING SURVEYS -->
                <div class="text-center py-5">
                    <div class="mb-3">
                        <span class="badge bg-light text-secondary p-4 rounded-circle border">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox text-muted" viewBox="0 0 16 16">
                                <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a1 1 0 0 1 .109 1.018l-1 8A1 1 0 0 1 14 18H2a1 1 0 0 1-.991-.876l-1-8a1 1 0 0 1 .109-1.018z"/>
                            </svg>
                        </span>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">No pending surveys</h3>
                    <p class="text-muted small mx-auto mb-3" style="max-width: 480px;">
                        You are all caught up! There are currently no pending surveys available for your Personnel Number (PERNR: <code>@pernr</code>).
                    </p>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
                        ● All Surveys Up To Date
                    </span>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var s in Model)
                    {
                        bool isSubmitted = submittedSurveyIds.Contains(s.Id);
                        <div class="col-12">
                            <div class="card border rounded-4 p-4 shadow-sm h-100 transition-all hover-shadow" 
                                 style="border-left: 6px solid @(isSubmitted ? "#198754" : "#673ab7") !important;">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div class="flex-grow-1" style="max-width: 650px;">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            @if (isSubmitted)
                                            {
                                                <span class="badge bg-success rounded-pill px-2 py-1 small">
                                                    ✓ Completed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small">
                                                    ● Pending Action
                                                </span>
                                            }
                                            <span class="text-muted small">
                                                Created on @s.CreatedAt.ToString("dd-MMM-yyyy")
                                            </span>
                                        </div>

                                        <h5 class="fw-bold text-dark mb-1">@s.Title</h5>
                                        @if (!string.IsNullOrWhiteSpace(s.Description))
                                        {
                                            <p class="text-muted small mb-0">@s.Description</p>
                                        }
                                    </div>

                                    <div>
                                        @if (isSubmitted)
                                        {
                                            <a asp-action="AttendSurvey" asp-route-id="@s.Id" asp-route-pernr="@pernr" 
                                               class="btn btn-outline-success rounded-pill px-4 shadow-sm fw-semibold">
                                                Edit Response &rarr;
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="AttendSurvey" asp-route-id="@s.Id" asp-route-pernr="@pernr" 
                                               class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold text-white" 
                                               style="background-color: #673ab7; border-color: #673ab7;">
                                                Attend Survey &rarr;
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
