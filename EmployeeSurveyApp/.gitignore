## Ignore Visual Studio / .NET Build and Temporary Files

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.ide/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json

# Test Results & Profiling
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.visualstudio/
*.coverage
*.coveragexml

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Node / Web temporary files (if any are introduced later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sensitive appsettings & connection strings
**/appsettings.json
**/appsettings.*.json
!**/appsettings.example.json
